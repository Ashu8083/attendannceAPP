import uuid

from app.repo.user_device_repo import UserDeviceDetailRepo
from app.schemas.userdevice_schema import (
    UserDeviceCreate,
    UserDeviceUpdate,
)


class UserDeviceService:

    def __init__(self, repo: UserDeviceDetailRepo):
        self.repo = repo

    def create_user_device(
        self,
        user_id: uuid.UUID,
        userdevice: UserDeviceCreate,
    ):
        return self.repo.create_user_device(
            user_id=user_id,
            userdevice=userdevice,
        )

    def update_user_device(
        self,
        user_id: uuid.UUID,
        device_unique_id: str,
        userdevice: UserDeviceUpdate,
    ):
        return self.repo.update_on_userdevice(
            user_id=user_id,
            user_device_id=device_unique_id,
            userdeviceupdate=userdevice,
        )

    def logout_device(
        self,
        user_id: uuid.UUID,
        device_unique_id: str,
        userdevice: UserDeviceUpdate,
    ):
        return self.repo.update_on_user_logout(
            user_id=user_id,
            user_device_id=device_unique_id,
            userdeviceupdate=userdevice,
        )

    def get_active_device(
        self,
        user_id: uuid.UUID,
        device_unique_id: str,
    ):
        return self.repo.get_active_device(
            user_id=user_id,
            device_unique_id=device_unique_id,
        )

    def get_by_fcm_token(
        self,
        fcm_token: str,
    ):
        return self.repo.get_by_fcm_token(
            fcm_token=fcm_token,
        )

    def get_refresh_token(
        self,
        user_id: uuid.UUID,
        refresh_token: str,
    ):
        return self.repo.user_refresh_token(
            user_id=user_id,
            refresh_token=refresh_token,
        )

    def delete_device(self, device):
        self.repo.delete(device)

    def logout_single_device(
        self,
        device_id: uuid.UUID,
        logout_time,
    ):
        self.repo.logout_device(
            device_id=device_id,
            logout_time=logout_time,
        )

    def logout_all_devices(
        self,
        user_id: uuid.UUID,
        logout_time,
    ):
        self.repo.logout_all_devices(
            user_id=user_id,
            logout_time=logout_time,
        )